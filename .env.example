# Copy this file to .env.local and put your own values there.
# .env.local is ignored by git. Nothing in this file is a real secret.

# Staff account for /kitchen. The phone number is also in .env
STAFF_PHONE=900000001
STAFF_PASSWORD=change-me-8-chars-or-more

# The address of the site. Used for social preview links, the sitemap and robots.txt.
# On the platform set it to the real address, for example https://your-app.vercel.app
# NEXT_PUBLIC_ values are copied into the browser bundle at build time, so change it, then rebuild.
# This one is not secret. Never put a secret in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
