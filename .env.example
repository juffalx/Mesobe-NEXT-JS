# Copy this file to .env.local and put your own values there.
# .env.local is ignored by git. Nothing in this file is a real secret.

# Staff account for /kitchen. The phone number is also in .env
STAFF_PHONE=900000001
STAFF_PASSWORD=change-me-8-chars-or-more

# Anything starting with NEXT_PUBLIC_ is copied into the browser bundle at build time.
# Never put a secret in a NEXT_PUBLIC_ variable. There are none in this project yet.
